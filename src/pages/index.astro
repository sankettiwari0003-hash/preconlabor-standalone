    <script is:inline>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-hidden', String(!open));
      });

      document.querySelectorAll('.hotspot').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          document.querySelectorAll('.hotspot').forEach((other) => {
            if (other !== btn) other.classList.remove('open');
          });
          btn.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(btn.classList.contains('open')));
        });
      });
      document.addEventListener('click', () => {
        document.querySelectorAll('.hotspot').forEach((btn) => btn.classList.remove('open'));
      });

      const slides = Array.from(document.querySelectorAll('.testimonial-slide'));
      let index = 0;
      const visible = () => (window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1);
      const render = () => {
        const v = visible();
        slides.forEach((slide, i) => {
          const show = i >= index && i < index + v;
          slide.classList.toggle('hidden', !show);
          slide.classList.toggle('lg:block', false);
          if (show) slide.classList.remove('hidden');
        });
      };
      document.getElementById('testimonial-next')?.addEventListener('click', () => {
        index = (index + 1) % slides.length;
        if (index + visible() > slides.length) index = 0;
        render();
      });
      document.getElementById('testimonial-prev')?.addEventListener('click', () => {
        index = (index - 1 + slides.length) % slides.length;
        render();
      });
      window.addEventListener('resize', render);
      render();
    </script>
